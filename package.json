{
  "name": "boss-local-job-radar",
  "version": "0.0.1",
  "private": true,
  "description": "Local-first BOSS job radar: read-only observation, local scoring, search suggestions, and tailored materials.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron:dev": "ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron electron/main.cjs",
    "electron:start": "npm run build && electron electron/main.cjs",
    "smoke": "tsx scripts/llm-smoke.ts",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "check": "npm run test && npm run build",
    "verify:electron": "node scripts/verify-electron-scaffold.mjs",
    "verify:browser-extension": "node scripts/verify-browser-extension-readonly-boundary.mjs",
    "verify:release": "npm run verify:electron && npm run verify:browser-extension && node scripts/verify-release.mjs"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "electron": "^42.5.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@vitejs/plugin-react": "^4.7.0",
    "antd": "^6.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "pdfjs-dist": "5.4.296"
  }
}
